+/* Only the pool's NAPI writes its completion ring. Failed paced sends
+ * originate on any CPU and hand the reserved address back to that NAPI.
+ */
+void xsk_pacing_discard(struct xdp_frame *frame)
+{
+	struct xsk_buff_pool *pool = frame->pool;
+	struct net_device *dev;
+	u32 prod;
+	bool queued = false;
+
+	if (frame->flags & XDP_FLAGS_XSK_QUEUEING_NO_COMP)
+		return;
+
+	spin_lock_bh(&pool->pacing_completion_lock);
+	if (unlikely(READ_ONCE(pool->pacing_stopped)))
+		goto unlock;
+
+	prod = pool->pacing_completion_prod;
+	/* Every entry here owns one reservation in this completion ring. */
+	if (WARN_ON_ONCE(prod - pool->pacing_completion_cons >= pool->cq->nentries))
+		goto unlock;
+	pool->pacing_completions[prod & pool->cq->ring_mask] = frame->desc_addr;
+	WRITE_ONCE(pool->pacing_completion_prod, prod + 1);
+	queued = true;
+unlock:
+	spin_unlock_bh(&pool->pacing_completion_lock);
+
+	if (!queued)
+		return;
+	dev = READ_ONCE(pool->netdev);
+	if (dev && dev->netdev_ops->ndo_xsk_wakeup)
+		dev->netdev_ops->ndo_xsk_wakeup(dev, pool->queue_id, XDP_WAKEUP_TX);
+}
+
+bool xsk_pacing_complete(struct xsk_buff_pool *pool, u32 budget)
+{
+	u32 cons, count, i;
+	bool pending;
+
+	if (READ_ONCE(pool->pacing_completion_cons) ==
+	    READ_ONCE(pool->pacing_completion_prod))
+		return false;
+
+	spin_lock_bh(&pool->pacing_completion_lock);
+	cons = pool->pacing_completion_cons;
+	count = min(budget, pool->pacing_completion_prod - cons);
+	for (i = 0; i < count; i++, cons++)
+		xsk_ooo_cq(pool->cq,
+			  pool->pacing_completions[cons & pool->cq->ring_mask]);
+	WRITE_ONCE(pool->pacing_completion_cons, cons);
+	pending = cons != pool->pacing_completion_prod;
+	spin_unlock_bh(&pool->pacing_completion_lock);
+
+	xsk_tx_completed(pool, count);
+	return pending;
+}
+EXPORT_SYMBOL_GPL(xsk_pacing_complete);
