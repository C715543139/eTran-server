+#define MLX5E_HANDOFF_INTERVAL_MS 1
+#define MLX5E_HANDOFF_MAX_RETRIES 50
 
 static void mlx5e_handle_tx_dim(struct mlx5e_txqsq *sq)
 {
@@ -85,6 +81,142 @@ void mlx5e_trigger_irq(struct mlx5e_icosq *sq)
 	mlx5e_notify_hw(wq, sq->pc, sq->uar_map, &nopwqe->ctrl);
 }
 
+/* handoff_lock serializes the retry timer with poll and channel shutdown. */
+static void mlx5e_trigger_handoff_icosq(struct mlx5e_channel *c)
+{
+	struct mlx5e_icosq *sq = &c->async_icosq;
+
+	if (c->handoff_kicked)
+		return;
+
+	spin_lock_bh(&c->async_icosq_lock);
+	/* Leave room for the ordinary XSK wakeup and reserved WQEs. */
+	if (test_bit(MLX5E_SQ_STATE_ENABLED, &sq->state) &&
+	    mlx5e_wqc_has_room_for(&sq->wq, READ_ONCE(sq->cc), sq->pc,
+				  sq->reserved_room + 2)) {
+		mlx5e_trigger_irq(sq);
+		c->handoff_kicked = true;
+		c->stats->force_irq++;
+	}
+	spin_unlock_bh(&c->async_icosq_lock);
+}
+
+static enum hrtimer_restart mlx5e_handoff_timer_cb(struct hrtimer *timer)
+{
+	struct mlx5e_channel *c = container_of(timer, struct mlx5e_channel,
+					       handoff_timer);
+	enum hrtimer_restart next = HRTIMER_NORESTART;
+
+	spin_lock_bh(&c->handoff_lock);
+	if (test_bit(MLX5E_CHANNEL_STATE_HANDOFF_STOP, c->state) ||
+	    napi_disable_pending(&c->napi) ||
+	    !test_bit(MLX5E_CHANNEL_STATE_HANDOFF_PENDING, c->state))
+		goto unlock;
+
+	c->handoff_kicked = false;
+	if (++c->handoff_retries >= MLX5E_HANDOFF_MAX_RETRIES) {
+		clear_bit(MLX5E_CHANNEL_STATE_HANDOFF_PENDING, c->state);
+		set_bit(MLX5E_CHANNEL_STATE_HANDOFF_FAILED, c->state);
+		c->stats->aff_handoff_timeout++;
+		netdev_warn(c->netdev,
+			    "NAPI handoff timed out for channel %d (CPU %d)\n",
+			    c->ix, c->handoff_target_cpu);
+		/* Keep data moving on the fallback CPU. A later poll can
+		 * resume normal service there or see a different route.
+		 * The normal NAPI completion path can resume the watchdog.
+		 */
+		mlx5e_trigger_handoff_icosq(c);
+		napi_schedule(&c->napi);
+		goto unlock;
+	}
+
+	c->stats->aff_handoff_retry++;
+	if (!test_bit(NAPI_STATE_SCHED, &c->napi.state))
+		mlx5e_trigger_handoff_icosq(c);
+	hrtimer_forward_now(timer, ms_to_ktime(MLX5E_HANDOFF_INTERVAL_MS));
+	next = HRTIMER_RESTART;
+unlock:
+	spin_unlock_bh(&c->handoff_lock);
+	return next;
+}
+
+void mlx5e_handoff_init(struct mlx5e_channel *c)
+{
+	spin_lock_init(&c->handoff_lock);
+	hrtimer_init(&c->handoff_timer, CLOCK_MONOTONIC,
+		     HRTIMER_MODE_REL_PINNED_SOFT);
+	c->handoff_timer.function = mlx5e_handoff_timer_cb;
+	set_bit(MLX5E_CHANNEL_STATE_HANDOFF_STOP, c->state);
+}
+
+void mlx5e_handoff_stop(struct mlx5e_channel *c)
+{
+	spin_lock_bh(&c->handoff_lock);
+	set_bit(MLX5E_CHANNEL_STATE_HANDOFF_STOP, c->state);
+	clear_bit(MLX5E_CHANNEL_STATE_HANDOFF_PENDING, c->state);
+	clear_bit(MLX5E_CHANNEL_STATE_HANDOFF_FAILED, c->state);
+	spin_unlock_bh(&c->handoff_lock);
+	hrtimer_cancel(&c->handoff_timer);
+}
+
+static bool mlx5e_handoff_poll(struct mlx5e_channel *c)
+{
+	bool irq_pending, on_target, handoff = false;
+	int cpu = smp_processor_id();
+	int target;
+
+	/* A threaded NAPI's CPU is chosen by the scheduler. */
+	if (READ_ONCE(c->napi.state) & (NAPIF_STATE_THREADED |
+				       NAPIF_STATE_NPSVC | NAPIF_STATE_IN_BUSY_POLL))
+		return false;
+
+	irq_pending = c->irq_data && irqd_is_setaffinity_pending(c->irq_data);
+	if (likely(!irq_pending && cpumask_test_cpu(cpu, c->aff_mask)) &&
+	    !test_bit(MLX5E_CHANNEL_STATE_HANDOFF_PENDING, c->state) &&
+	    !test_bit(MLX5E_CHANNEL_STATE_HANDOFF_FAILED, c->state))
+		return false;
+
+	spin_lock_bh(&c->handoff_lock);
+	if (test_bit(MLX5E_CHANNEL_STATE_HANDOFF_STOP, c->state))
+		goto unlock;
+
+	irq_pending = c->irq_data && irqd_is_setaffinity_pending(c->irq_data);
+	target = cpumask_first(c->aff_mask);
+	on_target = !irq_pending && cpumask_test_cpu(cpu, c->aff_mask);
+	if (on_target) {
+		clear_bit(MLX5E_CHANNEL_STATE_HANDOFF_FAILED, c->state);
+		if (test_and_clear_bit(MLX5E_CHANNEL_STATE_HANDOFF_PENDING,
+				       c->state)) {
+			hrtimer_try_to_cancel(&c->handoff_timer);
+			c->stats->aff_handoff_done++;
+		}
+		goto unlock;
+	}
+
+	if (target != c->handoff_target_cpu ||
+	    irq_pending != c->handoff_irq_pending) {
+		clear_bit(MLX5E_CHANNEL_STATE_HANDOFF_FAILED, c->state);
+		clear_bit(MLX5E_CHANNEL_STATE_HANDOFF_PENDING, c->state);
+	}
+	if (test_bit(MLX5E_CHANNEL_STATE_HANDOFF_FAILED, c->state))
+		goto unlock;
+
+	if (!test_and_set_bit(MLX5E_CHANNEL_STATE_HANDOFF_PENDING, c->state)) {
+		c->handoff_target_cpu = target;
+		c->handoff_irq_pending = irq_pending;
+		c->handoff_retries = 0;
+		c->handoff_kicked = false;
+		c->stats->aff_change++;
+		hrtimer_start(&c->handoff_timer,
+			      ms_to_ktime(MLX5E_HANDOFF_INTERVAL_MS),
+			      HRTIMER_MODE_REL_PINNED_SOFT);
+	}
+	handoff = true;
+unlock:
+	spin_unlock_bh(&c->handoff_lock);
+	return handoff;
+}
+
 static bool mlx5e_napi_xsk_post(struct mlx5e_xdpsq *xsksq, struct mlx5e_rq *xskrq)
 {
 	bool need_wakeup = xsk_uses_need_wakeup(xskrq->xsk_pool);
@@ -131,6 +263,7 @@ int mlx5e_napi_poll(struct napi_struct *napi, int budget)
 	struct mlx5e_rq *xskrq = &c->xskrq;
 	struct mlx5e_rq *rq = &c->rq;
 	bool aff_change = false;
+	bool missed;
 	bool busy_xsk = false;
 	bool busy = false;
 	int work_done = 0;
@@ -202,19 +335,19 @@ int mlx5e_napi_poll(struct napi_struct *napi, int budget)
 
 	busy |= busy_xsk;
 
-	if (busy) {
-		if (likely(mlx5e_channel_no_affinity_change(c))) {
+	if (unlikely(mlx5e_handoff_poll(c))) {
+		if (!napi_complete_aff_change(napi, &missed)) {
 			work_done = budget;
 			goto out;
 		}
-		ch_stats->aff_change++;
 		aff_change = true;
-		if (work_done == budget)
-			work_done--;
-	}
-
-	if (unlikely(!napi_complete_done(napi, work_done)))
+		work_done = min(work_done, budget - 1);
+	} else if (busy) {
+		work_done = budget;
+		goto out;
+	} else if (unlikely(!napi_complete_done(napi, work_done))) {
 		goto out;
+	}
 
 	ch_stats->arm++;
 
@@ -247,10 +380,14 @@ int mlx5e_napi_poll(struct napi_struct *napi, int budget)
 		mlx5e_cq_arm(&xskrq->cq);
 	}
 
-	if (unlikely(aff_change && busy_xsk) &&
-	    test_bit(MLX5E_SQ_STATE_ENABLED, &c->async_icosq.state)) {
-		mlx5e_trigger_napi_icosq(c);
-		ch_stats->force_irq++;
+	if (unlikely(aff_change)) {
+		/* Also kick when the old poll consumed a MISSED request or
+		 * completed a short batch: there may be no later CQ event.
+		 */
+		spin_lock_bh(&c->handoff_lock);
+		if (test_bit(MLX5E_CHANNEL_STATE_HANDOFF_PENDING, c->state))
+			mlx5e_trigger_handoff_icosq(c);
+		spin_unlock_bh(&c->handoff_lock);
 	}
 
 out:
