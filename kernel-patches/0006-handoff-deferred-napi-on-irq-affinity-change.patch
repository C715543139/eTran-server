 	}
 	WRITE_ONCE(n->list_owner, -1);
 
+	/* Serialize a timer arm at the tail of the previous poll against
+	 * cancellation by the next owner. Cancel before releasing SCHED so
+	 * the old owner cannot cancel the next owner's timer.
